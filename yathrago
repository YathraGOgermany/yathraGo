<script>

async function shareWebsite(){

    const shareData = {

        title:
        "YathraGo Germany",

        text:
        "Join YathraGo Germany for our Paris trip on 21 November 2026.",

        url:
        window.location.href
    };


    if(navigator.share){

        try{

            await navigator.share(shareData);

        }catch(error){

            // Sharing cancelled by user.

        }

    }else{

        try{

            await navigator.clipboard.writeText(
                window.location.href
            );

            alert(
                "Website link copied. You can now share it on Instagram or WhatsApp."
            );

        }catch(error){

            alert(
                "Copy your website address from the browser and share it."
            );

        }

    }

}

